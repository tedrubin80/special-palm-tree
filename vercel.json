{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/demo/index.html" },
    { "source": "/data.json", "destination": "/demo/data.json" }
  ],
  "headers": [
    {
      "source": "/demo/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
